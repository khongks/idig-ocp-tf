##############################################################################
# 00-load-images – terraform.tfvars.example
#
# Uploads the IDIG product images to your target registry using the IBM
# image tool (podman or docker).
#
# Run this step standalone (not wired into the root main.tf):
#   cp terraform.tfvars.example terraform.tfvars
#   tofu init && tofu apply
#
# Sensitive values – supply via env vars instead of storing on disk:
#   export TF_VAR_docker_password="..."
##############################################################################

# "auto" (podman if installed, else docker), "podman" or "docker".
container_cli = "auto"

# idig-image-tool-<version>.tar.gz, found in the extracted
# idig-operator-release-files_<version>.zip.
image_tar_path = "/path/to/release-files/idig-image-tool-12.1.1.3.tar.gz"

# Optional: skip `load` and use an image-tool image that is already loaded.
# image_tool_ref = "idig-image-tool-12.1.1:latest"

# Target registry path (host[/namespace]) – no https:// prefix.
docker_registry = "myregistry.example.com/idig"
docker_user     = "myuser"
docker_password = "changeme"   # prefer TF_VAR_docker_password

# ---------------------------------------------------------------------------
# Optional – LA iFix. ONLY for v12.1.1.2 with Analytics enabled.
# Skip entirely on v12.1.1.3 or later.
# ---------------------------------------------------------------------------
install_ifix = false

