# ============================================================================
# Terraform / OpenTofu
# ============================================================================

# Local variable overrides – contain secrets
terraform.tfvars

# Provider plugins and module cache
.terraform/
.terraform.lock.hcl

# State files – may contain secrets; use remote state in production
terraform.tfstate
terraform.tfstate.backup

# Plan output files
*.tfplan

# Crash log
crash.log
crash.*.log

# ============================================================================
# Generated / rendered manifests
# ============================================================================

# Rendered templatefile() outputs (contain substituted secrets/namespaces)
**/templates/.rendered/*.yaml

# Keep the .rendered directory itself tracked
!**/templates/.rendered/.gitkeep

# ============================================================================
# TLS certificates (generated by the cert-creation script)
# ============================================================================

certs/ca.key
certs/ca.crt
certs/ca.srl
certs/tls.key
certs/tls.csr
certs/tls.crt
certs/san.cnf

# ============================================================================
# macOS
# ============================================================================

.DS_Store
.AppleDouble
.LSOverride

# ============================================================================
# Editor / IDE
# ============================================================================

.vscode/
.idea/
*.swp
*.swo
*~
