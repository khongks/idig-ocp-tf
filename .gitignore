# ============================================================================
# Terraform / OpenTofu
# ============================================================================

# Local variable overrides – contain secrets
terraform.tfvars

# Provider plugins and module cache
.terraform/
.terraform.lock.hcl

# State files – may contain secrets; use remote state in production
terraform.tfstate
terraform.tfstate.backup

# 00-load-images scratch (temporary registry auth, ifix extraction)
.work/

# Plan output files
*.tfplan

# Crash log
crash.log
crash.*.log

# ============================================================================
# Generated / rendered manifests (contain namespace/registry values)
# ============================================================================

**/.rendered/

# ============================================================================
# Legacy Valkey TLS certificates (now generated by the tls provider)
# ============================================================================

certs/ca.key
certs/ca.crt
certs/ca.srl
certs/tls.key
certs/tls.csr
certs/tls.crt
certs/san.cnf

# ============================================================================
# macOS
# ============================================================================

.DS_Store
.AppleDouble
.LSOverride

