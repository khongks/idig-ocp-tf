##############################################################################
# IBM DataPower Interact Gateway – terraform.tfvars.example
#
# Sample variable values for all steps (00 – 07).
# Copy this file to the relevant step directory as terraform.tfvars and fill
# in your values before running:
#
#   cd <step-dir>
#   cp ../terraform.tfvars.example terraform.tfvars
#   # edit terraform.tfvars
#   tofu init && tofu apply
#
# Sensitive values (passwords, keys) should be supplied via environment
# variables instead of being stored on disk:
#   export TF_VAR_docker_password="..."
#   export TF_VAR_ibm_entitlement_key="..."
#   export TF_VAR_ifix_source_creds="cp:<IBM_ENTITLEMENT_KEY>"
#   export TF_VAR_watsonx_api_key="..."
##############################################################################


##############################################################################
# 00-load-images
# Loads the IDIG image archive into your target container registry and,
# optionally, copies an ifix image via skopeo.
# Run standalone – NOT wired into the root main.tf.
##############################################################################

# Absolute path to the IDIG image archive (.tar or .tgz) supplied by IBM.
image_tar_path = "/path/to/idig-12.1.1.2-images.tar.gz"

# Target container registry that will hold the uploaded IDIG images.
docker_registry = "myregistry.example.com/idig"
docker_user     = "myuser"
docker_password = "mypassword"   # prefer TF_VAR_docker_password env var

# ── Optional ifix via skopeo ──────────────────────────────────────────────
# Set install_ifix = true and fill in the three ifix_* variables to copy an
# ifix image from a remote registry directly into your target registry.
install_ifix = false

# Full image reference in the source registry (e.g. IBM Container Registry).
ifix_source_image = "cp.icr.io/cp/datapower/idig:12.1.1.2-ifix1"

# Full image reference in your target registry.
ifix_dest_image = "myregistry.example.com/idig/idig:12.1.1.2-ifix1"

# Credentials for the source registry in user:password format.
# For the IBM Container Registry use:  cp:<IBM_ENTITLEMENT_KEY>
# Prefer TF_VAR_ifix_source_creds env var.
ifix_source_creds = "cp:eyJhbGci..."


##############################################################################
# 01-prereqs
# Creates the IDIG namespace, configures default storage, installs
# cert-manager via OLM, and sets up the ingress-ca ClusterIssuer.
##############################################################################

# Absolute path to the OCP kubeconfig YAML file.
kubeconfig_path = "/path/to/kubeconfig.yaml"

# Kubernetes namespace to create for IDIG.
namespace = "idig-system"

# StorageClass to annotate as the cluster default.
# Leave empty ("") to skip – use this when your cluster already has a default.
storage_class_name = ""

# Shared storage volume size for the Analytics component.
analytics_volume_size = "200Gi"


##############################################################################
# 02-prep
# Creates the registry pull secret, IBM entitlement key secret, and the
# optional WatsonX credentials secret in the IDIG namespace.
##############################################################################

# (namespace and docker_registry/docker_user/docker_password shared above)

# IBM Entitlement Key from https://myibm.ibm.com/products-services/containerlibrary
# Prefer TF_VAR_ibm_entitlement_key env var.
ibm_entitlement_key = "eyJhbGci..."

# Optional – leave both empty to skip WatsonX / GenAI service secret.
# Prefer TF_VAR_watsonx_api_key env var.
watsonx_api_key    = ""
watsonx_project_id = ""


##############################################################################
# 03-operators
# Deploys the APIC, NanoGW, Valkey, and IDIG operators via OLM manifests.
##############################################################################

# Local path to the extracted IDIG product release files directory.
release_files_path = "/path/to/idig-12.1.1-release-files"

# Path to directory containing Valkey TLS certs (ca.crt, tls.crt, tls.key).
# Generated by the cert-creation script; defaults to ./certs.
valkey_certs_dir = "./certs"


##############################################################################
# 04-idig-cluster
# Deploys the IDIGCluster custom resource.
##############################################################################

# Full apps subdomain of the OCP cluster.
endpoint_domain = "apps.mycluster.example.com"

# Deployment profile: dev (minimal resources) or prod (HA).
idig_profile = "dev"

# Tenant and group names embedded in the IDIG cluster CR.
idig_tenant_name = "acme"
idig_group_name  = "sandbox"

# Component toggles.
enable_analytics  = true
enable_dev_portal = true

# IDIG product version string used in the cluster CR.
idig_version = "12.1.1.2"

# License type: nonproduction or production.
license_use = "nonproduction"

# IBM license identifier for the IDIG cluster CR.
license_id = "L-PAZT-LQ5TZL"

# Dependency sentinel – value of module.operators.idig_operator_ready output.
# Set this when running step 04 standalone after step 03 has completed.
operators_ready = ""


##############################################################################
# 05-wildcard-routes
# Patches OCP Routes to enable wildcard / passthrough routing.
##############################################################################

# Dependency sentinel – value of module.idig_cluster.idig_cluster_applied.
# Set this when running step 05 standalone after step 04 has completed.
idig_cluster_applied = ""


##############################################################################
# 06-verification
# Waits for all IDIG pods to become Ready and prints a status summary.
##############################################################################

# (kubeconfig_path and namespace shared above – no additional variables)


##############################################################################
# 07-access
# Prints access URLs and retrieves initial credentials for the IDIG cluster.
##############################################################################

# Name of the IDIGCluster custom resource created in step 04.
idig_cr_name = "idig"

# (namespace and endpoint_domain shared above – no additional variables)
