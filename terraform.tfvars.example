##############################################################################
# IBM DataPower Interact Gateway 12.1.1.3 on OpenShift – terraform.tfvars.example
#
# Root module (steps 01–07):
#   cp terraform.tfvars.example terraform.tfvars   # edit values
#   tofu init && tofu apply
#
# Step 00 (image upload) is separate – see 00-load-images/terraform.tfvars.example.
#
# Prefer environment variables for secrets:
#   export TF_VAR_docker_password="..."
#   export TF_VAR_ibm_entitlement_key="..."
#   export TF_VAR_watsonx_api_key="..."
##############################################################################

# --- Cluster ------------------------------------------------------------------
kubeconfig_path = "/path/to/kubeconfig"
namespace       = "idig-system"

# Base domain for IDIG endpoints – normally the cluster apps domain.
#   oc get ingresses.config/cluster -o jsonpath='{.spec.domain}'
endpoint_domain = "apps.mycluster.example.com"

# --- Release files and images --------------------------------------------------
# Extracted idig-operator-release-files_<version> directory.
release_files_path = "/path/to/idig-operator-release-files_12.1.1.3"

# Same registry used in 00-load-images (host[/namespace], no https://).
docker_registry = "myregistry.example.com/idig"
docker_user     = "myuser"
docker_password = "changeme" # prefer TF_VAR_docker_password

# https://myibm.ibm.com/products-services/containerlibrary
ibm_entitlement_key = "eyJhbGci..." # prefer TF_VAR_ibm_entitlement_key

# --- Prerequisites ---------------------------------------------------------------
# StorageClass for IDIG, Analytics and Valkey. "" = cluster default.
storage_class_name = ""
# Annotate storage_class_name as the cluster default (cluster-wide change).
set_default_storage_class = false
# Installs the cert-manager Operator for Red Hat OpenShift if missing; an
# existing OLM install is detected and skipped.
install_cert_manager = true
# Set wildcardPolicy=WildcardsAllowed on the default IngressController (cluster-wide).
enable_wildcard_routes = true

# --- IDIG cluster CR ----------------------------------------------------------
idig_cr_name     = "idig" # max 5 characters
idig_version     = "12.1.1.3"
idig_profile     = "dev"  # dev | prod
idig_tenant_name = "acme"
idig_group_name  = "sandbox"

enable_analytics      = true
# Analytics needs vm.max_map_count >= 262144 on workers. When true, a Tuned
# profile is applied (no reboot) only if a worker is below that value.
configure_max_map_count = true
analytics_volume_size = "200Gi"
enable_dev_portal     = true

license_use = "nonproduction" # nonproduction | production
license_id  = "L-PAZT-LQ5TZL"

# Optional: spec.nanoGateway.gatewayDomain ("" = idig.<endpoint_domain>)
# nanogw_gateway_domain = ""
# Optional: spec.runtimeConfig.logLevel (trace|debug|info|warn|error|off)
# runtime_log_level = "info"

# --- Optional WatsonX (GenAI service) -------------------------------------------
# Leave watsonx_api_key empty to skip the GenAI service.
watsonx_api_key    = "" # prefer TF_VAR_watsonx_api_key
watsonx_project_id = ""
