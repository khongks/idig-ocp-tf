##############################################################################
# IBM DataPower Interact Gateway – OpenTofu root variables
# https://www.ibm.com/docs/en/dp-interact-gateway/12.1.1?topic=openshift-deploying
##############################################################################

variable "kubeconfig_path" {
  description = "Absolute path to the OCP kubeconfig YAML file."
  type        = string
}

variable "namespace" {
  description = "Kubernetes namespace for the IDIG deployment (e.g. idig-system)."
  type        = string
  default     = "idig-system"
}

variable "endpoint_domain" {
  description = "Full apps subdomain of the OCP cluster (e.g. apps.mycluster.example.com)."
  type        = string
}

variable "docker_registry" {
  description = "Target container registry URL that holds the uploaded IDIG images."
  type        = string
}

variable "docker_user" {
  description = "Username for the target container registry."
  type        = string
}

variable "docker_password" {
  description = "Password / API key for the target container registry."
  type        = string
  sensitive   = true
}

variable "ibm_entitlement_key" {
  description = "IBM Entitlement Key for pulling DataPower NanoGateway images from cp.icr.io."
  type        = string
  sensitive   = true
}

variable "valkey_certs_dir" {
  description = "Path to directory containing Valkey TLS certs (ca.crt, tls.crt, tls.key) generated by the cert-creation script."
  type        = string
  default     = "./certs"
}

variable "idig_profile" {
  description = "Deployment profile: dev or prod."
  type        = string
  default     = "dev"
  validation {
    condition     = contains(["dev", "prod"], var.idig_profile)
    error_message = "idig_profile must be 'dev' or 'prod'."
  }
}

variable "idig_tenant_name" {
  description = "Tenant name for the IDIG cluster CR."
  type        = string
  default     = "acme"
}

variable "idig_group_name" {
  description = "Group name for the IDIG cluster CR."
  type        = string
  default     = "sandbox"
}

variable "storage_class_name" {
  description = "StorageClass name to use for IDIG Analytics persistent volumes."
  type        = string
  default     = ""
}

variable "analytics_volume_size" {
  description = "Shared storage volume size for the Analytics component (e.g. 200Gi)."
  type        = string
  default     = "200Gi"
}

variable "enable_analytics" {
  description = "Deploy the Analytics component."
  type        = bool
  default     = true
}

variable "enable_dev_portal" {
  description = "Deploy the Developer Portal component."
  type        = bool
  default     = true
}

variable "idig_version" {
  description = "IDIG product version string for the cluster CR (e.g. 12.1.1.2)."
  type        = string
  default     = "12.1.1.2"
}

variable "license_use" {
  description = "License use: nonproduction or production."
  type        = string
  default     = "nonproduction"
  validation {
    condition     = contains(["nonproduction", "production"], var.license_use)
    error_message = "license_use must be 'nonproduction' or 'production'."
  }
}

variable "license_id" {
  description = "IBM license identifier for the IDIG cluster CR (e.g. L-PAZT-LQ5TZL)."
  type        = string
  default     = "L-PAZT-LQ5TZL"
}

variable "watsonx_api_key" {
  description = "Optional WatsonX API key for GenAI service. Leave empty to skip."
  type        = string
  default     = ""
  sensitive   = true
}

variable "watsonx_project_id" {
  description = "Optional WatsonX Project ID for GenAI service. Leave empty to skip."
  type        = string
  default     = ""
}

variable "release_files_path" {
  description = "Local path to the extracted IDIG product release files directory."
  type        = string
}
